# Les sous-titres sont contrôlés par empreinte SHA-256 (src/data/local-videos.json) :
# fins de ligne LF sur tous les postes, même avec core.autocrlf=true.
*.vtt text eol=lf
# Manifeste régénéré en LF par scripts/prepare-media.mjs à chaque build :
# évite une modification fantôme sur les postes en CRLF.
src/data/responsive-images.json text eol=lf
# Vérification Google Search Console : publiée à l'identique, quel que soit le poste.
public/google*.html text eol=lf
*.sh text eol=lf
*.py text eol=lf
deploy/*.conf text eol=lf
deploy/known_hosts text eol=lf
