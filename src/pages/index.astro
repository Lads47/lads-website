    <meta property="og:description" content="Captation vid&eacute;o multicam&eacute;ra et production live pour vos &eacute;v&eacute;nements. Interventions &agrave; Bordeaux, Paris et partout en France.">
    <meta property="og:image" content="https://lesateliersdustream.fr/images/og-default.jpg">
