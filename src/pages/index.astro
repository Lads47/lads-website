    <meta name="description" content="Captation vid&eacute;o multicam&eacute;ra et production live pour vos &eacute;v&eacute;nements &agrave; Bordeaux, Paris et partout en France. Plus de 25 ans d'expertise audiovisuelle.">
    <link rel="canonical" href="https://lesateliersdustream.fr/">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://lesateliersdustream.fr/">
