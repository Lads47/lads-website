---
import '../styles/global.css';
import '../styles/site.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import Lightbox from '../components/site/Lightbox.astro';

interface Props { shell?: boolean; home?: boolean; schema?: boolean; lightbox?: boolean }
const { shell = true, home = false, schema = true, lightbox = false } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {shell && <>
      <link rel="stylesheet" href="/header.css" />
      <link rel="stylesheet" href="/footer.css" />
    </>}
    <slot name="head" />
    <script is:inline defer src="https://evaremote.com/e.js" data-site="lads" data-liens></script>
  </head>
  <body class:list={[home && 'home', !shell && 'standalone']}>
    {shell && <>
      <a href="#main-content" class="skip-link">Aller au contenu</a>
      <SiteHeader home={home} />
    </>}
    <main id="main-content"><slot /></main>
    {shell && <SiteFooter />}
    {lightbox && <Lightbox />}
    {schema && <script is:inline src="/schema.js"></script>}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
