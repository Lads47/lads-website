---
import '../styles/global.css';
import '../styles/site.css';
import Nav from '../components/global/Nav.astro';
import Footer from '../components/global/Footer.astro';
import Lightbox from '../components/site/Lightbox.astro';

interface Props { shell?: boolean; home?: boolean; schema?: boolean; lightbox?: boolean }
const { shell = true, home = false, schema = true, lightbox = false } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {home && <link rel="preload" as="image" href="/videos/demo-ateliers-du-stream.webp" fetchpriority="high" />}
    <slot name="head" />
    <script is:inline defer src="https://evaremote.com/e.js" data-site="lads" data-liens></script>
  </head>
  <body class:list={['theme-light', home && 'home', !shell && 'standalone']}>
    {shell && <>
      <a href="#main-content" class="skip-link">Aller au contenu</a>
      <Nav overlap home={home} />
    </>}
    <main id="main-content"><slot /></main>
    {shell && <Footer />}
    {lightbox && <Lightbox />}
    {schema && <script is:inline src="/schema.js"></script>}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
