---
import NavLink from "@/components/global/NavLink.astro";
import Img from "@/components/media/Img.astro";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
  /** Transparent navigation over the homepage hero; logo links to the top. */
  home?: boolean;
}

const { render = true, overlap = false, home = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '');
const contactHref = ['/mentions-legales','/politique-confidentialite'].includes(path) ? '/#contact' : '#contact';
const links = [['/','Accueil'],['/solutions','Nos solutions'],['/realisations','Nos réalisations'],['/approche','Notre accompagnement'],['/formations','Nos formations'],['/histoire','Notre histoire']];
---

{render && (
  <header id="header" class:list={["nav_wrap", overlap && "overlap", home && "home"]}>
    <div class="nav_inner">
      <a class="nav_logo" href={home ? '#' : '/'} aria-label={SITE_NAME + ' — accueil'}>
        {home && <Img src="/images/LOGO_clair.svg" alt={SITE_NAME} appearance="logo" data-mode="light" loading="eager" transparent />}
        <Img src="/images/LOGO_fonce.svg" alt={SITE_NAME} appearance="logo" data-mode="dark" loading="eager" transparent />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="site-navigation"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="site-navigation" aria-label="Navigation principale">
        <div class="nav_menu_inner">
          <ul class="nav_links">
            {links.map(([href,label]) => <NavLink href={href!}>{label}</NavLink>)}
            <NavLink href={contactHref}>Nous contacter</NavLink>
          </ul>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_wrap.home:not(.scrolled) {
      --heading-accent: var(--link-text);
      background: var(--background);
      color: var(--text);
      border-color: var(--border);
    }
    .nav_wrap .nav_logo [data-mode="light"] { opacity: 0; }
    .nav_wrap .nav_logo [data-mode="dark"] { opacity: 1; }
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  import mediaTokens from '@/styles/media-tokens.json';
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia(mediaTokens['--mq-navigation-desktop'])
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 6.5rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (--mq-hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (--mq-hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition: grid-template-rows var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: color-mix(in lab, currentcolor 60%, transparent);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (--mq-hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    @media (--mq-navigation-desktop) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-4);
        font-size: var(--text-small);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding-block: 0;
        &[aria-current="page"] {
          text-decoration: underline;
        }
      }
    }
  }
</style>

<style is:global>
@layer components {
  .nav_wrap {
    box-shadow: var(--shadow-surface);
    transition:
      background-color var(--hover-duration) var(--hover-ease),
      color var(--hover-duration) var(--hover-ease),
      border-color var(--hover-duration) var(--hover-ease);
  }
  .nav_logo { position: relative; width: calc(var(--space-8) + var(--space-5)); }
  .nav_wrap.home:not(.scrolled) { --heading-accent: var(--brand-500); background: transparent; color: var(--light-100); border-color: transparent; }
  .nav_logo [data-mode] { transition: opacity var(--hover-duration) var(--hover-ease); }
  .nav_logo [data-mode="light"] {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    translate: 0 -50%;
    width: 100%;
    opacity: 0;
  }
  .nav_wrap.home:not(.scrolled) .nav_logo [data-mode="light"] { opacity: 1; }
  .nav_wrap.home:not(.scrolled) .nav_logo [data-mode="dark"] { opacity: 0; }
  .nav_wrap.scrolled { background: var(--light-100); color: var(--dark-900); }
  .nav_links { font-size: var(--text-small); text-transform: uppercase; letter-spacing: var(--label-tracking); font-weight: var(--primary-bold); }
  .nav_link { color: inherit; }
  .nav_link[data-active="true"], .nav_link:hover { color: var(--heading-accent); }
  @media (--mq-navigation-desktop) { .nav_menu { flex: 1; } .nav_links { gap: var(--space-3); justify-content: space-between; } .nav_link { padding-inline: 0; } }
  @media (--mq-navigation-mobile) { .nav_menu { --heading-accent: var(--link-text); background: var(--light-100); color: var(--dark-900); } }
}
</style>
