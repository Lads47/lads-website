---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    })
  | (HTMLAttributes<"span"> & { element: "text"; href?: never; type?: never; disabled?: never });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      /** Arrow direction. */
      direction?: "forward" | "back" | "up";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back" | "up";
    element?: "button" | "link" | "text";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isLink = element === "link";
const Tag = isLink ? "a" : element === "text" ? "span" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : element === "text" ? {} : { type: type === "submit" ? undefined : type };

const marks = { play, close, arrow };
/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};
---

{render && (isWritten ? content : true) && (
  <Tag
    class:list={[
      "button_wrap",
      emphasis !== "primary" && emphasis,
      variant !== "main" && variant,
      variant === "arrow" && direction === "back" && "back",
      variant === "arrow" && direction === "up" && "up",
      className,
    ]}
    aria-label={isWritten ? undefined : (label ?? named[variant])}
    aria-pressed={variant === "play" ? pressed : undefined}
    {...tagAttrs}
    {...rest}
  >
    {isWritten && (
      <span class="button_text text-style-trim">
        <Fragment set:html={content} />
      </span>
    )}
    {variant === "play" && (
      <Fragment>
        <Icon class="button_mark button_play" src={play} variant="small" />
        <Icon class="button_mark button_pause" src={pause} variant="small" />
      </Fragment>
    )}
    {variant === "close" && (
      <Icon class="button_mark" src={marks.close} variant="small" />
    )}
    {variant === "arrow" && (
      <Icon class="button_mark" src={marks.arrow} variant="small" />
    )}
  </Tag>
)}

<style is:global>
  @layer components {
    .button_wrap {
      display: inline-flex;
      justify-content: var(--justify-content-button-wrap);
      align-items: center;
      gap: var(--size-0-5em);
      padding: var(--size-0-75em) var(--size-1-5em);
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--size-0-5em);
      line-height: var(--number-1-2);
      text-decoration: none;
      text-align: center;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (--mq-hover) {
        &:hover:not(:disabled) {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: var(--color-transparent);
        --button-text: var(--link-text);
        --button-border: var(--link-border);
        --button-background-hover: var(--color-transparent);
        --button-text-hover: var(--link-text-hover);
        --button-border-hover: var(--link-border);

        padding: var(--size-0-4em) var(--size-zero);
        border: var(--size-zero);
        border-bottom: var(--border-width) solid var(--button-border);
        border-radius: var(--size-zero);
        background-image: linear-gradient(
          var(--link-border-hover),
          var(--link-border-hover)
        );
        background-repeat: no-repeat;
        background-origin: border-box;
        background-position: var(--size-full) var(--size-full);
        background-size: var(--size-zero) var(--border-width);
        transition:
          background-size calc(var(--hover-duration) * var(--number-two)) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease);
        @media (--mq-hover) {
          &:hover:not(:disabled) {
            background-position: var(--size-zero) var(--size-full);
            background-size: var(--size-full) var(--border-width);
          }
        }
      }
      &:is(.play, .close, .arrow) {
        gap: var(--size-zero);
        padding: var(--size-0-75em);
        border-radius: var(--radius-round);
      }
      &.back .button_mark {
        rotate: var(--angle-180deg);
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: var(--opacity-0-5);
      }
    }
  }
</style>

<style is:global>
@layer components {
  .button_wrap { font-size: var(--text-small); font-weight: var(--primary-bold); text-transform: uppercase; letter-spacing: var(--size-0-1em); padding: var(--space-4) var(--space-6); border-radius: var(--radius-small); }
  .button_wrap.up .button_mark { rotate: var(--angle-minus-90deg); }
  .button_text { display: inline-flex; align-items: center; gap: var(--space-2); }
  .button_text > svg { width: var(--size-1-125rem); height: var(--size-1-125rem); stroke: currentColor; stroke-width: var(--number-two); fill: none; }
}
</style>
