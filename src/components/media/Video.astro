---
import type { HTMLAttributes } from "astro/types";
import mediaTokens from '@/styles/media-tokens.json';

type VideoRatio = "2-1" | "16-9" | "3-2" | "5-4" | "1-1" | "4-5" | "2-3";

type Head = Omit<
  HTMLAttributes<"video">,
  "src" | "poster" | "loop" | "autoplay" | "muted"
> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Video URL. Omit to render nothing. */
  src?: string;
  /** Poster image URL. */
  poster?: string;
  /** Smaller version of the same complete video, selected on narrow screens. */
  mobileSrc?: string;
};

type Tail = {
  /** Restart after playback. */
  loop?: boolean;
  /** Start automatically. Requires `muted`. */
  autoplay?: boolean;
  /** Mute audio. */
  muted?: boolean;
  /** Fit without cropping and remove the skeleton tint. */
  transparent?: boolean;
};

type Props = Head &
  (
    | {
        /** Aspect ratio. */
        variant?: VideoRatio;
        ratio?: never;
      }
    | {
        variant: "custom";
        /** CSS `aspect-ratio` value. */
        ratio?: string;
      }
    | {
        variant: "auto";
        ratio?: never;
      }
  ) &
  Tail;

type AllProps = Head &
  Tail & {
    variant?: VideoRatio | "custom" | "auto";
    ratio?: string;
  };

const {
  render = true,
  src,
  poster,
  mobileSrc,
  variant = "16-9",
  ratio,
  loop = true,
  autoplay = true,
  muted = true,
  transparent = false,
  class: className,
  ...rest
} = Astro.props as AllProps;

if (import.meta.env.DEV && render) {
  if (!src) {
    console.warn(
      "[lumos] <Video> rendered without a `src`; nothing was output.",
    );
  }
  if (autoplay && !muted) {
    console.warn(
      "[lumos] <Video autoplay> without `muted` is blocked by every major browser. Set muted, or drop autoplay and let the viewer start it.",
    );
  }
  if (variant === "custom" && !ratio) {
    console.warn(
      '[lumos] <Video variant="custom"> has no `ratio`, so no aspect ratio is applied. Set one, or pick a preset variant.',
    );
  }
}

const isCustom = variant === "custom";
---

{render && src && (
  <video
    src={mobileSrc ? undefined : src}
    poster={poster}
    class:list={[
      "video",
      !isCustom && `ratio-${variant}`,
      transparent && "transparent",
      className,
    ]}
    style={isCustom && ratio ? `aspect-ratio: ${ratio};` : undefined}
    loop={loop}
    autoplay={autoplay}
    muted={muted}
    playsinline
    {...rest}
  >
    {mobileSrc && <>
      <source src={mobileSrc} media={mediaTokens['--mq-compact-max']} type="video/mp4" />
      <source src={src} type="video/mp4" />
    </>}
  </video>
)}
