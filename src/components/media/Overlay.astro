---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Overlay style. */
  variant?: "solid" | "gradient" | "ambient";
  /**
   * Tint strength as a percentage.
   *
   * @min 0
   * @max 100
   * @int
   */
  strength?: number;
}

const {
  render = true,
  variant = "solid",
  strength = 50,
  class: className,
  ...rest
} = Astro.props;
---

{render && (
  <div
    class:list={["overlay", variant !== "solid" && variant, className]}
    style={`--_strength: ${strength};`}
    {...rest}
  />
)}

<style is:global>
  @layer components {
    .overlay {
      position: absolute;
      inset: var(--size-zero);
      width: var(--size-full);
      height: var(--size-full);
      background-color: color-mix(
        in srgb,
        var(--color-black) calc(var(--_strength, 50) / var(--number-100) * var(--percentage-80)),
        var(--color-transparent)
      );

      &.gradient {
        background-color: color-mix(
          in srgb,
          var(--color-black) calc(var(--_strength, 50) / var(--number-100) * var(--percentage-60)),
          var(--color-transparent)
        );
        background-image: linear-gradient(
          to bottom,
          var(--color-transparent),
          color-mix(
              in srgb,
              var(--color-black) calc(var(--_strength, 50) / var(--number-100) * var(--percentage-62)),
              var(--color-transparent)
            )
            var(--percentage-84)
        );
      }
      &.ambient { background: var(--contact-gradient); }
    }
  }
</style>
