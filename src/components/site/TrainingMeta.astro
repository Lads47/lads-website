---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> { highlighted?: boolean }
const { highlighted = false, class: className, ...attrs } = Astro.props;
---
<div class:list={['training-meta', highlighted && 'highlighted', className]} {...attrs}><slot /></div>
<style is:global>
@layer components {
  .training-meta { display: flex; align-items: start; gap: var(--space-3); }
  .training-meta > svg { width: 1.375rem; height: 1.375rem; flex: none; stroke: var(--brand-500); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .training-meta > div { min-width: 0; }
  .training-meta.highlighted { padding: var(--space-4); background: var(--background-3); border-radius: var(--radius-small); }
}
</style>
