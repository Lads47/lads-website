---
import Modal from '../interactive/Modal.astro';
---
<Modal id="photo-lightbox" label="Photographie agrandie" closeLabel="Fermer la photographie" variant="photo" class="theme-dark" closedby="any">
  <img alt="" />
</Modal>
<style is:global>
@layer components {
  .photo-trigger { display: block; width: var(--size-full); padding: var(--size-zero); border: var(--size-zero); background: var(--color-transparent); cursor: zoom-in; text-align: inherit; }
  .photo-trigger img { width: var(--size-full); }
}
</style>
