---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"dialog"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Modal ID for triggers, hash links, and `?modal=`. Required. */
  id?: string;
  /** Accessible label. */
  label?: string;
  /** Accessible label for the close control. */
  closeLabel?: string;
  /** Modal style. */
  variant?: "small" | "side-panel" | "full-screen" | "photo";
  /** Keep open in design mode. */
  preview?: boolean;
};

const {
  render = true,
  id,
  label,
  closeLabel = "Fermer",
  variant = "small",
  preview = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);

if (import.meta.env.DEV && render && content && !id) {
  console.warn(
    "[lumos] <Modal> rendered without an `id`, so nothing could open it and nothing was output.",
  );
}
---

{render && id && content && (
  <dialog
    id={id}
    class:list={[
      "modal_wrap",
      variant !== "small" && variant,
      preview && "preview",
      className,
    ]}
    aria-label={label}
    {...rest}
  >
    <div class="modal_content">
      <Button
        class="modal_close"
        variant="close"
        label={closeLabel}
        emphasis="secondary"
        autofocus
        data-modal-close
      />
      <div class="modal_scroll" data-modal-scroll>
        <div class="modal_body margin-trim">
          <Fragment set:html={content} />
        </div>
      </div>
    </div>
  </dialog>
)}

<script>
  for (const modal of document.querySelectorAll<HTMLDialogElement>(
    ".modal_wrap",
  )) {
    const scroll = modal.querySelector<HTMLElement>("[data-modal-scroll]");

    const open = () => {
      if (modal.open) return;
      if (scroll) scroll.scrollTop = 0;
      modal.showModal();
      modal.dispatchEvent(new CustomEvent("modal-open", { bubbles: true }));
    };

    modal.addEventListener("close", () =>
      modal.dispatchEvent(new CustomEvent("modal-close", { bubbles: true })),
    );

    let fromBackdrop = false;

    modal.addEventListener("mousedown", (event) => {
      fromBackdrop = event.target === modal;
    });

    modal.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest("[data-modal-close]")) modal.close();
      else if (fromBackdrop && target === modal) modal.close();
      fromBackdrop = false;
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest(
        `[data-modal-open="${modal.id}"], a[href="#${modal.id}"]`,
      );
      if (!trigger) return;
      event.preventDefault();
      open();
    });

    const url = new URL(location.href);
    if (url.searchParams.get("modal") === modal.id) {
      open();
      url.searchParams.delete("modal");
      history.replaceState(history.state, "", url);
    }
  }
</script>

<style is:global>
  @layer components {
    html:has(.modal_wrap[open]) {
      overflow: hidden;
    }

    .modal_wrap {
      --_leaving: calc(var(--open-duration) * var(--opacity-0-7));
      --_from: var(--size-zero) var(--size-2rem);
      --_body: var(--size-zero) var(--size-zero);
      --_backdrop: color-mix(in lab, var(--color-black) var(--percentage-60), var(--color-transparent));
      --_close: calc(var(--size-2-75em) + var(--space-4) * var(--number-two));
      width: var(--size-full);
      max-width: none;
      height: var(--size-full);
      max-height: none;
      margin: var(--size-zero);
      padding: var(--site-margin);
      align-items: center;
      justify-content: var(--justify-content-button-wrap);
      background: none;
      border: var(--size-zero);
      color: var(--text);
      overflow: clip;
      transition:
        display var(--_leaving) allow-discrete,
        overlay var(--_leaving) allow-discrete;

      &[open] {
        display: flex;
        transition:
          display var(--open-duration) allow-discrete,
          overlay var(--open-duration) allow-discrete;
      }

      .stacki-designer &.preview,
      &.stacki-opened {
        display: flex;
        position: fixed;
        inset: var(--size-zero);
        z-index: var(--layer-100);
        background-color: var(--_backdrop);
      }

      &::backdrop {
        background-color: var(--_backdrop);
        opacity: var(--opacity-0);
        transition: opacity var(--_leaving) var(--open-ease);
      }

      &[open]::backdrop {
        opacity: var(--opacity-1);
        transition: opacity var(--open-duration) var(--open-ease);
      }

      @starting-style {
        &[open]::backdrop {
          opacity: var(--opacity-0);
        }
      }

      &.side-panel {
        --_panel: var(--size-28rem);
        --_from: var(--_panel) var(--size-zero);
        padding: var(--size-zero);
        align-items: stretch;
        justify-content: var(--justify-content-side-panel);
      }

      &.full-screen {
        --_from: var(--size-zero) var(--size-zero);
        --_body: var(--size-zero) var(--size-2rem);
        padding: var(--size-zero);
        align-items: stretch;
      }
    }

    .modal_content {
      position: relative;
      display: flex;
      flex-direction: column;
      width: var(--size-full);
      max-width: var(--size-34rem);
      max-height: var(--size-full);
      background-color: var(--background);
      border-radius: var(--radius-main);
      overflow: hidden;
      opacity: var(--opacity-0);
      translate: var(--_from);
      transition:
        opacity var(--_leaving) var(--open-ease),
        translate var(--_leaving) var(--open-ease);

      .modal_wrap.side-panel & {
        max-width: var(--_panel);
        max-height: none;
        border-radius: var(--size-zero);
      }

      .modal_wrap.full-screen & {
        max-width: none;
        max-height: none;
        border-radius: var(--size-zero);
      }

      .modal_wrap:is([open], .stacki-opened) &,
      .stacki-designer .modal_wrap.preview & {
        opacity: var(--opacity-1);
        translate: var(--size-zero) var(--size-zero);
        transition:
          opacity var(--open-duration) var(--open-ease),
          translate var(--open-duration) var(--open-ease);
      }

      @starting-style {
        .modal_wrap[open] & {
          opacity: var(--opacity-0);
          translate: var(--_from);
        }
      }
    }

    .modal_close {
      position: absolute;
      top: var(--space-4);
      inset-inline-end: var(--space-4);
      z-index: var(--number-one);
    }

    .modal_scroll {
      flex: var(--number-one);
      min-height: var(--size-zero);
      overflow-y: auto;
      overscroll-behavior: contain;

      .modal_wrap.full-screen & {
        height: var(--size-full);
      }
    }

    .modal_body {
      padding: var(--_close) var(--space-6) var(--space-7);
      translate: var(--_body);
      transition: translate var(--_leaving) var(--open-ease);

      .modal_wrap.full-screen & {
        min-height: var(--size-full);
        display: grid;
        align-content: var(--align-content-modal-wrap-full-screen);
      }

      .modal_wrap:is([open], .stacki-opened) &,
      .stacki-designer .modal_wrap.preview & {
        translate: var(--size-zero) var(--size-zero);
        transition: translate var(--open-duration) var(--open-ease);
      }

      @starting-style {
        .modal_wrap[open] & {
          translate: var(--_body);
        }
      }
    }
  }
</style>

<style is:global>
@layer components {
  .modal_wrap.photo { padding: var(--size-5vh) var(--size-5vw); --_body: var(--size-zero); }
  .modal_wrap.photo .modal_content { width: auto; max-width: var(--size-90vw); max-height: var(--size-90vh); background: var(--color-transparent); overflow: visible; }
  .modal_wrap.photo .modal_body { padding: var(--size-zero); }
  .modal_wrap.photo img { max-width: var(--size-90vw); max-height: var(--size-85vh); width: auto; height: auto; object-fit: contain; }
  .modal_wrap.photo .modal_close { position: fixed; top: var(--space-4); right: var(--space-5); z-index: var(--number-one); }
}
</style>
