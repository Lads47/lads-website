---
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Img from '../media/Img.astro';
---
<!-- ============================================
         PAGE HERO
         ============================================ -->
    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Notre accompagnement</Eyebrow>
                <Heading tag="h1" variant="h1">Comment pr&eacute;parons-nous votre &eacute;v&eacute;nement ?</Heading>
                <Paragraph variant="large">
                    Chaque projet est unique et a ses sp&eacute;cificit&eacute;s. Conscients de cela, nous nous employons
                    &agrave; une &eacute;coute active de vos besoins pour vous proposer le meilleur service possible
                    avant, pendant et apr&egrave;s votre &eacute;v&eacute;nement.
                </Paragraph>
            </ContentWrapper>

    </Section>

    <!-- ============================================
         NOTRE APPROCHE — TIMELINE
         ============================================ -->
    <Section theme="light">

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Notre approche</Eyebrow>
                <Heading tag="h2" variant="h2">De l'&eacute;coute &agrave; la r&eacute;alisation</Heading>
                <hr class="divider">
            </ContentWrapper>
            <Grid xsmall={1} small={1} medium={1} large={2} gap="8">
                <div class="process-visual">
                    <div class="process-photo">
                        <Img loading={"lazy"} src={"/images/visite-technique.avif"} alt={"Visite technique"} />
                        <span class="process-photo-caption">Visite technique avant l'&eacute;v&eacute;nement</span>
                    </div>
                    <div class="process-photo">
                        <Img loading={"lazy"} src={"/images/habillage_graphique.avif"} alt={"Habillage graphique"} />
                        <span class="process-photo-caption">Cr&eacute;ation d'un habillage vid&eacute;o</span>
                    </div>
                </div>
                <div>
                    <div class="timeline">
                        <div class="timeline-step">
                            <Heading tag="h4" variant="h4">&Eacute;change &amp; cadrage</Heading>
                            <Paragraph variant="main">Nous parlons ensemble de votre &eacute;v&eacute;nement, de ses besoins et de ses enjeux pour dimensionner le dispositif id&eacute;al.</Paragraph>
                        </div>
                        <div class="timeline-step">
                            <Heading tag="h4" variant="h4">Coordination technique</Heading>
                            <Paragraph variant="main">Nous prenons en charge la relation avec le lieu de l'&eacute;v&eacute;nement pour garantir la bonne connexion des &eacute;quipements et ne rien laisser au hasard.</Paragraph>
                        </div>
                        <div class="timeline-step">
                            <Heading tag="h4" variant="h4">Habillage &agrave; vos couleurs</Heading>
                            <Paragraph variant="main">Cr&eacute;ation d'habillages graphiques personnalis&eacute;s et, si besoin, d'une page web de diffusion du direct &agrave; votre charte graphique.</Paragraph>
                        </div>
                        <div class="timeline-step">
                            <Heading tag="h4" variant="h4">Le jour J, on g&egrave;re</Heading>
                            <Paragraph variant="main">Flexibilit&eacute; totale face aux impr&eacute;vus : modification d'un PowerPoint, intervenant en duplex, diffusion d'un film &agrave; la derni&egrave;re minute &mdash; nous nous adaptons.</Paragraph>
                        </div>
                        <div class="timeline-step">
                            <Heading tag="h4" variant="h4">Livraison des replays</Heading>
                            <Paragraph variant="main">Nous vous livrons vos vid&eacute;os habill&eacute;es avec le d&eacute;coupage th&eacute;matique de votre choix, avec la possibilit&eacute; d'une livraison d&egrave;s le lendemain.</Paragraph>
                        </div>
                    </div>
                </div>
            </Grid>

    </Section>


    <!-- ============================================
         CTA / CONTACT
         ============================================ -->
    <ContactSection eyebrow={"Parlons de votre projet"} title={"On passe à votre événement ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Footer -->



<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            width: var(--size-3-125rem); height: var(--size-0-1875rem); background: var(--brand-500);
            margin: var(--space-4) auto var(--size-zero); border: none;
        }

        /* ============================================
           SECTION — TIMELINE (depuis index.html)
           ============================================ */

        .process-visual {
            display: flex;
            flex-direction: column;
            gap: var(--size-0-625rem);
        }

        .process-photo {
            position: relative;
            flex: var(--number-one);
            display: flex;
            border-radius: var(--radius-small);
            overflow: hidden;
        }

        .process-photo-caption {
            position: absolute;
            bottom: var(--size-zero); left: var(--size-zero); right: var(--size-zero);
            padding: var(--size-0-625rem) var(--size-1rem);
            background: linear-gradient(var(--angle-0deg), var(--overlay-caption) var(--percentage-0), var(--color-transparent) var(--size-full));
            color: var(--light-100);
            font-size: var(--size-0-82rem);
            font-weight: var(--primary-medium);
            letter-spacing: var(--size-0-01875rem);
        }

        .timeline {
            position: relative;
            padding-left: var(--space-6);
        }

        .timeline::before {
            content: var(--content-timeline-before); position: absolute;
            left: var(--size-0-75rem); top: var(--size-0-5rem); bottom: var(--size-0-5rem);
            width: var(--size-0-125rem); background: var(--light-300);
        }

        .timeline-step {
            position: relative;
            margin-bottom: var(--size-2-1875rem);
            padding-left: var(--space-4);
        }

        .timeline-step:last-child { margin-bottom: var(--size-zero); }

        .timeline-step::before {
            content: var(--content-timeline-before); position: absolute;
            left: var(--size-minus-2-5rem); top: var(--size-0-375rem);
            width: var(--size-1-5rem); height: var(--size-1-5rem);
            border-radius: var(--percentage-50);
            background: var(--light-100);
            border: var(--size-0-1875rem) solid var(--brand-500);
            transition: var(--motion-transition);
            z-index: var(--number-one);
        }

        .timeline-step:hover::before {
            background: var(--brand-500);
            box-shadow: var(--shadow-timeline-step-hover-before);
        }

        /* ============================================
           SECTION — 3 PHASES (Avant / Pendant / Apr&egrave;s)
           ============================================ */
        .phases { background: var(--light-200); }

        .phase-row {
            display: grid;
            grid-template-columns: var(--size-1fr) var(--size-1fr);
            gap: var(--space-7);
            align-items: center;
            margin-bottom: var(--space-8);
        }
        .phase-row:last-child { margin-bottom: var(--size-zero); }
        .phase-row.reverse { direction: rtl; }
        .phase-row.reverse > * { direction: ltr; }

        .phase-visual {
            border-radius: var(--radius-small);
            overflow: hidden;
        }

        .phase-number {
            display: inline-block; font-size: var(--size-0-72rem); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--size-0-125rem);
            color: var(--brand-500); margin-bottom: var(--size-0-625rem);
        }

        /* ============================================
           RESPONSIVE
           ============================================ */
        @media (--mq-max-width-64rem) {
            .phase-row { grid-template-columns: var(--size-1fr); gap: var(--space-6); }
            .phase-row.reverse { direction: ltr; }
        }

}
</style>
