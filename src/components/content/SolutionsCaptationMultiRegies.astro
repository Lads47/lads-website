---
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Img from '../media/Img.astro';
import Button from '../Button.astro';
---
<!-- ============================================
         HEADER
         ============================================ -->



    <!-- ============================================
         PAGE HERO
         ============================================ -->
    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/20251031_162920 (1).webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">En simultan&eacute;</Eyebrow>
                <Heading tag="h1" variant="h1">8 r&eacute;gies en simultan&eacute;</Heading>
                <Paragraph variant="large">Jusqu'&agrave; 8 r&eacute;gies de 3 cam&eacute;ras d&eacute;ploy&eacute;es en m&ecirc;me temps pour vos &eacute;v&eacute;nements multi-salles</Paragraph>
            </ContentWrapper>

    </Section>

    <!-- Breadcrumb retour -->
    <div class="site-container">
        <a href="/solutions" class="breadcrumb-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour nos solutions
        </a>
    </div>

    <!-- ============================================
         DETAIL
         ============================================ -->
    <Section theme="light">

            <Grid xsmall={1} small={1} medium={1} large={2} gap="8" tracks="var(--tracks-content-sidebar)">
                <div class="real-detail-text">
                    <Eyebrow tag="span" variant="tag">En simultan&eacute;</Eyebrow>
                    <Heading tag="h2" variant="h2" class="alignment-start">8 r&eacute;gies de 3 cam&eacute;ras chacune</Heading>
                    <hr class="divider">
                    <br>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Nous sommes en mesure de d&eacute;ployer jusqu'&agrave; 8 r&eacute;gies de 3 cam&eacute;ras en simultan&eacute;. Id&eacute;al pour les &eacute;v&eacute;nements multi-salles&nbsp;: chaque conf&eacute;rence dispose de sa propre captation, en live ou en enregistrement.
                    </Paragraph>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Ce dispositif est pens&eacute; pour les grands &eacute;v&eacute;nements professionnels o&ugrave; plusieurs sessions se d&eacute;roulent en parall&egrave;le. Chaque salle b&eacute;n&eacute;ficie d'une r&eacute;gie autonome avec son propre r&eacute;alisateur, assurant une captation ind&eacute;pendante et de qualit&eacute; homog&egrave;ne sur l'ensemble de l'&eacute;v&eacute;nement.
                    </Paragraph>
                    <ul class="feature-list">
                        <li>Jusqu'&agrave; 8 r&eacute;gies d&eacute;ploy&eacute;es en simultan&eacute;</li>
                        <li>3 cam&eacute;ras par r&eacute;gie</li>
                        <li>Captation en live ou en enregistrement</li>
                        <li>R&eacute;gie autonome par salle</li>
                        <li>Id&eacute;al pour les congr&egrave;s et &eacute;v&eacute;nements multi-salles</li>
                        <li>Qualit&eacute; homog&egrave;ne sur l'ensemble des salles</li>
                    </ul>
                </div>
                <div class="real-meta">
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                        <div>
                            <span class="meta-label">Type de solution</span>
                            <span class="meta-value">Captation multi-r&eacute;gies</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="9" height="7" rx="1"/><rect x="14" y="3" width="9" height="7" rx="1"/><rect x="1" y="14" width="9" height="7" rx="1"/><rect x="14" y="14" width="9" height="7" rx="1"/></svg>
                        <div>
                            <span class="meta-label">Capacit&eacute;</span>
                            <span class="meta-value">Jusqu'&agrave; 8 r&eacute;gies simultan&eacute;es</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="12" x2="16" y2="12"/></svg>
                        <div>
                            <span class="meta-label">Cam&eacute;ras par r&eacute;gie</span>
                            <span class="meta-value">3 cam&eacute;ras</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <div>
                            <span class="meta-label">Usage</span>
                            <span class="meta-value">Congr&egrave;s &middot; Multi-salles &middot; S&eacute;minaires</span>
                        </div>
                    </div>
                </div>
            </Grid>

            <!-- Photo -->
            <Grid xsmall={1} small={1} medium={2} large={2} gap="4">
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20251031_162920 (1).webp"} alt={"Dispositif 8 régies en simultané"} appearance="photo" />
                    <p class="real-photo-caption">Pr&eacute;paration de 6 r&eacute;gies pour la captation en simultan&eacute; des 6 ateliers de BDX/IO (une 7i&egrave;me r&eacute;gie sera &eacute;galement utilis&eacute;e pour les pl&eacute;ni&egrave;res)</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20251107_172009.webp"} alt={"Les 7 régies en live sur Youtube BDX/IO"} appearance="photo" />
                    <p class="real-photo-caption">Sur l'&eacute;cran du haut &agrave; droite vous pouvez voir les 7 r&eacute;gies en live sur la cha&icirc;ne Youtube de BDX/IO</p>
                </div>
            </Grid>

            <!-- Back link -->
            <Button element="link" variant="link" href={"/solutions"}>
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Retour aux solutions
            </Button>

    </Section>

    <ContactSection eyebrow={"Vous avez un projet similaire ?"} title={"Et si on travaillait ensemble ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Lightbox -->


    <!-- Footer -->



<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            width: var(--size-3-125rem); height: var(--size-0-1875rem); background: var(--brand-500);
            margin: var(--space-4) var(--size-zero) var(--size-zero) var(--size-zero); border: none;
        }

        /* ============================================
           SOLUTION DETAIL
           ============================================ */
        .real-meta {
            display: flex; flex-direction: column; gap: var(--space-4);
            padding: var(--size-2-1875rem);
            background: var(--light-200);
            border-radius: var(--radius-small);
            border: var(--size-0-0625rem) solid var(--light-300);
        }
        .real-meta-item { display: flex; align-items: center; gap: var(--size-0-875rem); }
        .real-meta-item svg {
            width: var(--size-1-375rem); height: var(--size-1-375rem); flex-shrink: var(--size-zero);
            stroke: var(--brand-500); stroke-width: var(--number-two);
            fill: none; stroke-linecap: round; stroke-linejoin: round;
        }
        .meta-label {
            display: block; font-size: var(--size-0-7rem); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--size-0-0625rem);
            color: var(--text-2); margin-bottom: var(--size-0-125rem);
        }
        .meta-value {
            display: block; font-size: var(--size-0-95rem); font-weight: var(--primary-medium);
            color: var(--dark-900);
        }

        /* ============================================
           FEATURE LIST
           ============================================ */
        .feature-list { list-style: none; margin-top: var(--space-4); }
        .feature-list li {
            position: relative; padding-left: var(--size-1-375rem);
            font-size: var(--size-0-9rem); color: var(--text-2); line-height: var(--number-2-2);
        }
        .feature-list li::before {
            content: var(--content-timeline-before); position: absolute; left: var(--size-zero); top: var(--size-0-75rem);
            width: var(--size-0-625rem); height: var(--size-0-625rem); border-radius: var(--percentage-50);
            background: var(--brand-500);
        }

        /* ============================================
           PHOTO SECTION
           ============================================ */
        .real-photo-item { border-radius: var(--radius-small); overflow: hidden; cursor: pointer; }
        .real-photo-caption { font-size: var(--size-0-82rem); color: var(--text-2); font-style: italic; margin-top: var(--size-0-625rem); text-align: center; }

        /* Lightbox */

        /* ============================================
           BREADCRUMB BACK
           ============================================ */
        .breadcrumb-back {
            display: inline-flex; align-items: center; gap: var(--space-2);
            font-size: var(--size-0-78rem); font-weight: var(--primary-medium); text-transform: uppercase;
            letter-spacing: var(--size-0-0625rem); color: var(--text-2); transition: var(--motion-transition);
            padding: var(--space-5) var(--size-zero) var(--size-zero);
        }
        .breadcrumb-back:hover { color: var(--brand-500); }
        .breadcrumb-back svg {
            width: var(--size-1rem); height: var(--size-1rem); stroke: currentColor; stroke-width: var(--number-two);
            fill: none; transition: var(--motion-transition);
        }

        /* ============================================
           BACK LINK
           ============================================ */

        /* ============================================
           RESPONSIVE
           ============================================ */

}
</style>
