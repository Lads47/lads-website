---
import Button from '../Button.astro';
import Img from '../media/Img.astro';
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Card from '../item/Card.astro';
---
<Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/DSC_0118.webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Portfolio</Eyebrow>
                <Heading tag="h1" variant="h1">Nos r&eacute;alisations</Heading>
                <Paragraph variant="large">Depuis plus de vingt ans, nous avons r&eacute;alis&eacute; une multitude de prestations &agrave; destination de diff&eacute;rents secteurs&nbsp;: communication publique, sport, culture, corporate... Avec une expertise particuli&egrave;re pour la captation de conf&eacute;rences.</Paragraph>
            </ContentWrapper>

    </Section>

    <Section theme="light">

            <Grid xsmall={1} small={1} medium={2} large={3} gap="4">

                <!-- 1. Open International de la Côte de Beauté -->
                <Card variant="stacked" href={"/realisations/open-cote-de-beaute"} image={"/photo/20260816_145851.webp"} imageAlt={"Open International de la Côte de Beauté — régie de remote production à Marmande"}>


                        <Heading tag="h2" variant="h4">Open International de la C&ocirc;te de Beaut&eacute; &mdash; Saint-Georges-de-Didonne &mdash; 2026</Heading>
                        <Paragraph variant="main">Remote production d'un &eacute;v&eacute;nement sportif avec 4 cam&eacute;ras, replays, scoring en direct et diffusion sur &eacute;cran LED, r&eacute;alis&eacute;e &agrave; distance depuis Marmande.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 2. Runik TCG Series -->
                <Card variant="stacked" href={"/realisations/tcg"} image={"/photo/d%C3%A9mo.00_00_20_12.Still001.webp"} imageAlt={"Runik TCG Series — Bordeaux 2026"}>


                        <Heading tag="h2" variant="h4">Runik TCG Series &mdash; Bordeaux &mdash; 2026</Heading>
                        <Paragraph variant="main">Plateau TV 7 cam&eacute;ras et captation d'une table de TCG comp&eacute;titive (Lorcana), analyses replay, overlay avec les cartes jou&eacute;es en temps r&eacute;el.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 2. Peer Gynt -->
                <Card variant="stacked" href={"/realisations/peer-gynt"} image={"/photo/peer-gynt.webp"} imageAlt={"Peer Gynt - Opéra de Limoges"}>


                        <Heading tag="h2" variant="h4">Peer Gynt &mdash; Op&eacute;ra de Limoges &mdash; 2024</Heading>
                        <Paragraph variant="main">Six cam&eacute;ras diss&eacute;min&eacute;es sur le plateau, manipulables par les acteurs et une trentaine de vid&eacute;os diffus&eacute;es sur le mur du d&eacute;cor. R&eacute;gie &agrave; trois m&eacute;langeurs vid&eacute;o et liaison fibre optique.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 2. Jeu de r&ocirc;le -->
                <Card variant="stacked" href={"/realisations/jeu-de-role"} image={"/photo/20250405_185756.webp"} imageAlt={"Campagne de jeu de rôle"}>


                        <Heading tag="h2" variant="h4">Campagne de jeu de r&ocirc;le</Heading>
                        <Paragraph variant="main">7 cam&eacute;ras, affichage dynamique en temps r&eacute;el des jets de d&eacute;s et statistiques, diffusion sur Twitch et YouTube.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 3. Universit&eacute; de Bordeaux -->
                <Card variant="stacked" href={"/realisations/ceremonie-docteurs-bordeaux"} image={"/photo/20250411_165355.webp"} imageAlt={"Cérémonie des docteurs - Université de Bordeaux"}>


                        <Heading tag="h2" variant="h4">Remise des dipl&ocirc;mes des docteurs &mdash; Universit&eacute; de Bordeaux</Heading>
                        <Paragraph variant="main">Captation 5 cam&eacute;ras dans une salle de 1&nbsp;400 places, direct sur les r&eacute;seaux sociaux, liaison fibre optique &agrave; plus de 100 m&egrave;tres.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 4. Festival Imprim&eacute; -->
                <Card variant="stacked" href={"/realisations/festival-imprime"} image={"/photo/festival-imprime.webp"} imageAlt={"Festival Imprimé - Rocher de Palmer"}>


                        <Heading tag="h2" variant="h4">Festival Imprim&eacute; &mdash; Rocher de Palmer &mdash; 2024</Heading>
                        <Paragraph variant="main">Captation et multistream sur YouTube, Facebook et LinkedIn. Gestion et diffusion des m&eacute;dias sur vid&eacute;oprojecteur.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 5. CECA -->
                <Card variant="stacked" href={"/realisations/universite-ete-ceca"} image={"/photo/20240830_103011.webp"} imageAlt={"Université d'Été Ekivia - Château Smith Haut Lafitte"}>


                        <Heading tag="h2" variant="h4">Universit&eacute; d'&Eacute;t&eacute; du CECA &mdash; Ch&acirc;teau Smith Haut Lafitte &mdash; 2024</Heading>
                        <Paragraph variant="main">Captation et direct avec intervenants en duplex, connexion 5G double op&eacute;rateur, gestion des m&eacute;dias sur vid&eacute;oprojecteur.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 6. destiNAtion Europe -->
                <Card variant="stacked" href={"/realisations/destination-europe"} image={"/photo/20210601_144731.webp"} imageAlt={"destiNAtion Europe - Talence"}>


                        <Heading tag="h2" variant="h4">destiNAtion Europe &mdash; Talence &mdash; 2021</Heading>
                        <Paragraph variant="main">Plateau TV virtuel avec fond vert de 12 m&egrave;tres, intervenants en duplex et affichage dynamique de mots-cl&eacute;s en temps r&eacute;el.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 7. Salon Agriculture -->
                <Card variant="stacked" href={"/realisations/salon-agriculture-bordeaux"} image={"/photo/agri1.webp"} imageAlt={"Salon de l'Agriculture - Bordeaux"}>


                        <Heading tag="h2" variant="h4">Salon de l'Agriculture &mdash; Bordeaux</Heading>
                        <Paragraph variant="main">Plateau TV AgriWebTV avec 7 cam&eacute;ras, sonorisation, &eacute;missions quotidiennes enregistr&eacute;es et diffus&eacute;es en replay. &Eacute;crans publics et retour m&eacute;dias pour les invit&eacute;s.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 8. Inova-&eacute; -->
                <Card variant="stacked" href={"/realisations/inova-e"} image={"/photo/20240621_152608.webp"} imageAlt={"Inova-é - Multiplex"}>


                        <Heading tag="h2" variant="h4">Inova-&eacute; &mdash; Bordeaux, Limoges, Poitiers</Heading>
                        <Paragraph variant="main">&Eacute;v&eacute;nement hybride multi-sites, 3 cam&eacute;ras par site connect&eacute;es &agrave; une r&eacute;gie finale centralis&eacute;e. Mixage audio et vid&eacute;o centralis&eacute;.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 9. Etourisme -->
                <Card variant="stacked" href={"/realisations/etourisme-pau"} image={"/photo/20251016_085347.webp"} imageAlt={"Rencontres nationales de l'etourisme - Pau"}>


                        <Heading tag="h2" variant="h4">Rencontres nationales de l'etourisme &mdash; Pau</Heading>
                        <Paragraph variant="main">5 r&eacute;gies d&eacute;ploy&eacute;es dans des salles diff&eacute;rentes, 12 cam&eacute;ras dans le Palais Beaumont. Diffusion sur &eacute;crans g&eacute;ants et intervenants &agrave; distance.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

                <!-- 10. FIJ -->
                <Card variant="stacked" href={"/realisations/festival-journalisme-couthures"} image={"/photo/20220717_191121.webp"} imageAlt={"Festival international de journalisme - Couthures"}>


                        <Heading tag="h2" variant="h4">Festival international de journalisme &mdash; Couthures-sur-Garonne</Heading>
                        <Paragraph variant="main">R&eacute;gie HF avec 4 cam&eacute;ras sans c&acirc;blage, captation de l'&eacute;mission de Charline Vanhoenacker, direct Facebook et jingles sur &eacute;cran g&eacute;ant.</Paragraph>
                        <Button element="text" variant="link">D&eacute;couvrir <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></Button>

                </Card>

            </Grid>

    </Section>

    <!-- CTA -->
    <ContactSection eyebrow={"On ajoute votre événement ?"} title={"On ajoute votre événement ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Footer -->



<style is:global>
@layer components {

/* PAGE HERO */

        /* SECTIONS */
        .divider{margin:var(--space-4) auto 0}

        /* REALISATIONS GRID */

}
</style>
