---
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Img from '../media/Img.astro';
import Button from '../Button.astro';
---
<!-- ============================================
         PAGE HERO
         ============================================ -->
    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/20240830_102943.webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Corporate</Eyebrow>
                <Heading tag="h1" variant="h1">Universit&eacute; d'&Eacute;t&eacute; d'Ekivia &mdash; Ch&acirc;teau Smith Haut Lafitte</Heading>
                <Paragraph variant="large">2025</Paragraph>
            </ContentWrapper>

    </Section>

    <!-- Breadcrumb retour -->
    <div class="site-container">
        <a href="/realisations" class="breadcrumb-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour nos r&eacute;alisations
        </a>
    </div>

    <!-- ============================================
         DETAIL
         ============================================ -->
    <Section theme="light">

            <Grid xsmall={1} small={1} medium={1} large={2} gap="8" tracks="var(--tracks-content-sidebar)">
                <div class="real-detail-text">
                    <Eyebrow tag="span" variant="tag">Corporate</Eyebrow>
                    <Heading tag="h2" variant="h2" class="alignment-start">Universit&eacute; d'&Eacute;t&eacute; d'Ekivia &mdash; Ch&acirc;teau Smith Haut Lafitte &mdash; 2025</Heading>
                    <hr class="divider">
                    <br>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        L'Universit&eacute; d'&Eacute;t&eacute; d'Ekivia est le rendez-vous annuel des leaders humanistes avec des conf&eacute;renciers d'exception sur deux jours. Les prestations incluent la captation et la diffusion en direct de l'&eacute;v&eacute;nement avec la possibilit&eacute; pour des personnalit&eacute;s en duplex d'intervenir et &eacute;changer avec le public.
                    </Paragraph>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Des tests de connexion pr&eacute;alables avec les intervenants &agrave; distance, des publications de direct partag&eacute;es sur la plateforme d'Ekivia, la gestion de la diffusion des m&eacute;dias (powerpoints, vid&eacute;os) sur vid&eacute;oprojecteur. Solution technique flexible bas&eacute;e sur deux routeurs 5G d'op&eacute;rateurs diff&eacute;rents.
                    </Paragraph>
                </div>
                <div class="real-meta">
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        <div>
                            <span class="meta-label">Client</span>
                            <span class="meta-value">Ekivia</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <div>
                            <span class="meta-label">Ann&eacute;e</span>
                            <span class="meta-value">2025</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <div>
                            <span class="meta-label">Lieu</span>
                            <span class="meta-value">Ch&acirc;teau Smith Haut Lafitte</span>
                        </div>
                    </div>
                </div>
            </Grid>

            <!-- Photos -->
            <Grid xsmall={1} small={1} medium={2} large={2} gap="4">
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20240830_102943.webp"} alt={"Université d'Été d'Ekivia - La régie de captation"} appearance="photo" />
                    <p class="real-photo-caption">La r&eacute;gie de captation</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20240830_103011.webp"} alt={"Université d'Été d'Ekivia"} appearance="photo" />
                </div>
            </Grid>

            <!-- Back link -->
            <Button element="link" variant="link" href={"/realisations"}>
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Retour aux r&eacute;alisations
            </Button>

    </Section>

    <ContactSection eyebrow={"Vous avez un projet similaire ?"} title={"On ajoute votre événement ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Lightbox -->


    <!-- Footer -->



<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            width: var(--size-3-125rem); height: var(--size-0-1875rem); background: var(--brand-500);
            margin: var(--space-4) var(--size-zero) var(--size-zero) var(--size-zero); border: none;
        }

        /* ============================================
           REALISATION DETAIL
           ============================================ */
        .real-meta {
            display: flex; flex-direction: column; gap: var(--space-4);
            padding: var(--size-2-1875rem);
            background: var(--light-200);
            border-radius: var(--radius-small);
            border: var(--size-0-0625rem) solid var(--light-300);
        }
        .real-meta-item {
            display: flex; align-items: center; gap: var(--size-0-875rem);
        }
        .real-meta-item svg {
            width: var(--size-1-375rem); height: var(--size-1-375rem); flex-shrink: var(--size-zero);
            stroke: var(--brand-500); stroke-width: var(--number-two);
            fill: none; stroke-linecap: round; stroke-linejoin: round;
        }
        .meta-label {
            display: block; font-size: var(--size-0-7rem); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--size-0-0625rem);
            color: var(--text-2); margin-bottom: var(--size-0-125rem);
        }
        .meta-value {
            display: block; font-size: var(--size-0-95rem); font-weight: var(--primary-medium);
            color: var(--dark-900);
        }

        /* ============================================
           PHOTO SECTION
           ============================================ */
        .real-photo-item {
            border-radius: var(--radius-small);
            overflow: hidden;
            cursor: pointer;
        }
        .real-photo-caption {
            font-size: var(--size-0-82rem);
            color: var(--text-2);
            font-style: italic;
            margin-top: var(--size-0-625rem);
            text-align: center;
        }

        /* Lightbox */

        /* ============================================
           BREADCRUMB BACK
           ============================================ */
        .breadcrumb-back {
            display: inline-flex; align-items: center; gap: var(--space-2);
            font-size: var(--size-0-78rem); font-weight: var(--primary-medium); text-transform: uppercase;
            letter-spacing: var(--size-0-0625rem); color: var(--text-2); transition: var(--motion-transition);
            padding: var(--space-5) var(--size-zero) var(--size-zero);
        }
        .breadcrumb-back:hover { color: var(--brand-500); }
        .breadcrumb-back svg {
            width: var(--size-1rem); height: var(--size-1rem); stroke: currentColor; stroke-width: var(--number-two);
            fill: none; transition: var(--motion-transition);
        }

        /* ============================================
           BACK LINK
           ============================================ */

        /* ============================================
           RESPONSIVE
           ============================================ */

}
</style>
