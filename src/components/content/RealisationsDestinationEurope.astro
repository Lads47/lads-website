---
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Grid from '../wrapper/Grid.astro';
import Paragraph from '../typography/Paragraph.astro';
import Img from '../media/Img.astro';
import Button from '../Button.astro';
---
<!-- ============================================
         PAGE HERO
         ============================================ -->
    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/20210601_144731.webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Plateau TV</Eyebrow>
                <Heading tag="h1" variant="h1">destiNAtion Europe &mdash; Talence &mdash; 2021</Heading>
            </ContentWrapper>

    </Section>

    <!-- Breadcrumb retour -->
    <div class="site-container">
        <a href="/realisations" class="breadcrumb-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour nos r&eacute;alisations
        </a>
    </div>

    <!-- ============================================
         CONTENU
         ============================================ -->
    <Section theme="light">

            <Grid xsmall={1} small={1} medium={1} large={2} gap="8" tracks="var(--tracks-content-sidebar)">
                <div class="real-detail-text">
                    <Eyebrow tag="span" variant="tag">Plateau TV</Eyebrow>
                    <Heading tag="h2" variant="h2" class="alignment-start">destiNAtion Europe &mdash; Talence &mdash; 2021</Heading>
                    <hr class="divider">
                    <br>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        L'ADI Nouvelle-Aquitaine souhaitait communiquer les nouvelles directives europ&eacute;ennes sur les march&eacute;s publics &agrave; ses membres r&eacute;partis sur l'ensemble de la R&eacute;gion. Pour r&eacute;pondre &agrave; ce besoin, nous avons con&ccedil;u un plateau TV virtuel avec un fond vert de 12 m&egrave;tres de long.
                    </Paragraph>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Le dispositif permettait d'accueillir des intervenants en plateau mais aussi en duplex, et d'int&eacute;grer un affichage dynamique de mots-cl&eacute;s synchronis&eacute; avec les propos des intervenants. Des &eacute;l&eacute;ments de d&eacute;cor anim&eacute;s venaient enrichir la production, le tout diffus&eacute; en direct.
                    </Paragraph>
                </div>
                <div class="real-meta">
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        <div>
                            <span class="meta-label">Client</span>
                            <span class="meta-value">ADI Nouvelle-Aquitaine</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <div>
                            <span class="meta-label">Ann&eacute;e</span>
                            <span class="meta-value">2021</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <div>
                            <span class="meta-label">Lieu</span>
                            <span class="meta-value">Talence</span>
                        </div>
                    </div>
                </div>
            </Grid>

            <!-- Photos -->
            <Grid xsmall={1} small={1} medium={2} large={2} gap="4">
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20210601_144731.webp"} alt={"Le plateau TV virtuel"} appearance="photo" />
                    <p class="real-photo-caption">Le plateau TV virtuel</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20210406_151153.webp"} alt={"destiNAtion Europe"} appearance="photo" />
                </div>
            </Grid>

            <!-- Back link -->
            <Button element="link" variant="link" href={"/realisations"}>
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Retour aux r&eacute;alisations
            </Button>

    </Section>

    <ContactSection eyebrow={"On ajoute votre événement ?"} title={"On ajoute votre événement ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Lightbox -->


    <!-- Footer -->



<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            width: var(--size-3-125rem); height: var(--size-0-1875rem); background: var(--brand-500);
            margin: var(--space-4) var(--size-zero) var(--size-zero) var(--size-zero); border: none;
        }

        /* ============================================
           REALISATION DETAIL LAYOUT
           ============================================ */

        /* META SIDEBAR */
        .real-meta {
            display: flex; flex-direction: column; gap: var(--space-4);
            padding: var(--size-2-1875rem);
            background: var(--light-200);
            border-radius: var(--radius-small);
            border: var(--size-0-0625rem) solid var(--light-300);
        }
        .real-meta-item {
            display: flex;
            align-items: center;
            gap: var(--size-0-875rem);
        }
        .real-meta-item svg {
            width: var(--size-1-375rem); height: var(--size-1-375rem); flex-shrink: var(--size-zero);
            stroke: var(--brand-500); stroke-width: var(--number-two);
            fill: none; stroke-linecap: round; stroke-linejoin: round;
            margin-top: var(--size-0-125rem);
        }
        .meta-label {
            display: block; font-size: var(--size-0-7rem); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--size-0-0625rem);
            color: var(--text-2); margin-bottom: var(--size-0-125rem);
        }
        .meta-value {
            display: block; font-size: var(--size-0-95rem); font-weight: var(--primary-medium);
            color: var(--dark-900);
        }

        /* PHOTO SECTION */
        .real-photo-item {
            border-radius: var(--radius-small);
            overflow: hidden;
            cursor: pointer;
        }
        .real-photo-caption {
            font-size: var(--size-0-82rem);
            color: var(--text-2);
            font-style: italic;
            margin-top: var(--size-0-625rem);
            text-align: center;
        }

        /* Lightbox */

        /* Video */
        .video-container { margin-top: var(--space-4); position: relative; padding-bottom: var(--percentage-56-25); height: var(--size-zero); overflow: hidden; border-radius: var(--radius-small); }
        .video-container iframe { position: absolute; top: var(--size-zero); left: var(--size-zero); width: var(--size-full); height: var(--size-full); border: var(--size-zero); border-radius: var(--radius-small); }

        /* BREADCRUMB BACK */
        .breadcrumb-back {
            display: inline-flex; align-items: center; gap: var(--space-2);
            font-size: var(--size-0-78rem); font-weight: var(--primary-medium); text-transform: uppercase;
            letter-spacing: var(--size-0-0625rem); color: var(--text-2); transition: var(--motion-transition);
            padding: var(--space-5) var(--size-zero) var(--size-zero);
        }
        .breadcrumb-back:hover { color: var(--brand-500); }
        .breadcrumb-back svg {
            width: var(--size-1rem); height: var(--size-1rem); stroke: currentColor; stroke-width: var(--number-two);
            fill: none; transition: var(--motion-transition);
        }

        /* BACK LINK */

        /* ============================================
           RESPONSIVE
           ============================================ */

}
</style>
