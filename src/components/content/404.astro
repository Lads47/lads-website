---
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Img from '../media/Img.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Button from '../Button.astro';
---
<Section theme="dark" fullHeight paddingTop="small" paddingBottom="small" align="center">
  <ContentWrapper centered class="max-width-small">
    <Img src="/images/LOGO_clair.svg" alt="Les Ateliers du Stream" appearance="logo" transparent />
    <div class="error-code_wrap">404</div>
    <Heading tag="h1" variant="h3">Page introuvable</Heading>
    <Paragraph variant="main" class="color-muted">La page que vous recherchez n'existe pas ou a été déplacée.</Paragraph>
    <Button element="link" href="/">Retour à l'accueil</Button>
    <div class="error-links_wrap">
      <a href="/solutions">Solutions</a>{' '}<a href="/realisations">Réalisations</a>{' '}<a href="/formations">Formations</a>{' '}<a href="/approche">Accompagnement</a>{' '}<a href="/histoire">Histoire</a>
    </div>
  </ContentWrapper>
</Section>
<style is:global>
@layer components {
 .error-code_wrap { font-family: var(--heading-family); font-size: var(--size-6rem); font-weight: var(--weight-900); line-height: var(--number-one); color: var(--brand-500); }
 .error-links_wrap { display: flex; flex-wrap: wrap; justify-content: var(--justify-content-button-wrap); gap: var(--space-4); color: var(--brand-500); font-size: var(--text-small); }
}
</style>
