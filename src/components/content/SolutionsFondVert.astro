---
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Img from '../media/Img.astro';
import Button from '../Button.astro';
---
<!-- ============================================
         HEADER
         ============================================ -->



    <!-- ============================================
         PAGE HERO
         ============================================ -->
    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/20210406_151153.webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity);object-position:center calc(50% + 8.125rem)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Studio virtuel</Eyebrow>
                <Heading tag="h1" variant="h1">Fond vert</Heading>
                <Paragraph variant="large">Studio virtuel sur fond vert de 4 &agrave; 12&nbsp;m&egrave;tres de long et 2,20&nbsp;m&egrave;tres de haut</Paragraph>
            </ContentWrapper>

    </Section>

    <!-- Breadcrumb retour -->
    <div class="site-container">
        <a href="/solutions" class="breadcrumb-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour nos solutions
        </a>
    </div>

    <!-- ============================================
         DETAIL
         ============================================ -->
    <Section theme="light">

            <Grid xsmall={1} small={1} medium={1} large={2} gap="8" tracks="var(--tracks-content-sidebar)">
                <div class="real-detail-text">
                    <Eyebrow tag="span" variant="tag">Studio virtuel</Eyebrow>
                    <Heading tag="h2" variant="h2" class="alignment-start">Fond vert</Heading>
                    <hr class="divider">
                    <br>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Notre fond vert modulable de 4 &agrave; 12&nbsp;m&egrave;tres de long et 2,20&nbsp;m&egrave;tres de haut permet de r&eacute;aliser des productions immersives avec incrustation de d&eacute;cors virtuels en temps r&eacute;el.
                    </Paragraph>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Id&eacute;al pour cr&eacute;er un studio virtuel directement sur le lieu de votre &eacute;v&eacute;nement. Le fond vert s'adapte &agrave; vos besoins&nbsp;: interviews, pr&eacute;sentations, animations ou s&eacute;quences cr&eacute;atives avec incrustation de d&eacute;cors personnalis&eacute;s.
                    </Paragraph>
                    <ul class="feature-list">
                        <li>Fond vert modulable de 4 &agrave; 12&nbsp;m de long</li>
                        <li>Hauteur de 2,20&nbsp;m</li>
                        <li>Incrustation de d&eacute;cors virtuels en temps r&eacute;el</li>
                        <li>Installation sur site</li>
                        <li>Compatible avec nos r&eacute;gies de captation</li>
                    </ul>
                </div>
                <div class="real-meta">
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                        <div>
                            <span class="meta-label">Type de solution</span>
                            <span class="meta-value">Studio virtuel fond vert</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                        <div>
                            <span class="meta-label">Dimensions</span>
                            <span class="meta-value">4 &agrave; 12 m de long &middot; 2,20 m de haut</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="12" x2="16" y2="12"/></svg>
                        <div>
                            <span class="meta-label">Rendu</span>
                            <span class="meta-value">Incrustation temps r&eacute;el</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <div>
                            <span class="meta-label">Usage</span>
                            <span class="meta-value">Interviews &middot; Pr&eacute;sentations &middot; Animations</span>
                        </div>
                    </div>
                </div>
            </Grid>

            <!-- Photos -->
            <Grid xsmall={1} small={1} medium={2} large={3} gap="4">
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20210601_144731.webp"} alt={"Réalisation en direct sur fond vert"} appearance="photo" />
                    <p class="real-photo-caption">R&eacute;alisation en direct sur fond vert dans les locaux du client</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20210406_151153.webp"} alt={"12 mètres de fond vert"} appearance="photo" />
                    <p class="real-photo-caption">12 m&egrave;tres de fond vert et une cam&eacute;ra par intervenant</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/adi europe 2.webp"} alt={"Intégration finale"} appearance="photo" />
                    <p class="real-photo-caption">Une des sc&egrave;nes de l'int&eacute;gration finale</p>
                </div>
            </Grid>

            <!-- Back link -->
            <Button element="link" variant="link" href={"/solutions"}>
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Retour aux solutions
            </Button>

    </Section>

    <ContactSection eyebrow={"Vous avez un projet similaire ?"} title={"Et si on travaillait ensemble ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Lightbox -->


    <!-- Footer -->



<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            margin: var(--space-4) 0 0 0;
        }

        /* ============================================
           SOLUTION DETAIL
           ============================================ */
        .real-meta {
            display: flex; flex-direction: column; gap: var(--space-4);
            padding: var(--space-5);
            background: var(--light-200);
            border-radius: var(--radius-small);
            border: var(--border-width) solid var(--light-300);
        }
        .real-meta-item { display: flex; align-items: center; gap: var(--space-3); }
        .real-meta-item svg {
            width: 1.375rem; height: 1.375rem; flex-shrink: 0;
            stroke: var(--brand-500); stroke-width: 2;
            fill: none; stroke-linecap: round; stroke-linejoin: round;
        }
        .meta-label {
            display: block; font-size: var(--text-small); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--letter-spacing-normal);
            color: var(--text-2); margin-bottom: var(--space-1);
        }
        .meta-value {
            display: block; font-size: var(--text-main); font-weight: var(--primary-medium);
            color: var(--dark-900);
        }

        /* ============================================
           FEATURE LIST
           ============================================ */
        .feature-list { list-style: none; margin-top: var(--space-4); }
        .feature-list li {
            position: relative; padding-left: var(--space-4);
            font-size: var(--text-small); color: var(--text-2); line-height: var(--text-main-line-height);
        }
        .feature-list li::before {
            content: ''; position: absolute; left: 0; top: 0.75rem;
            width: 0.625rem; height: 0.625rem; border-radius: 50%;
            background: var(--brand-500);
        }

        /* ============================================
           PHOTO SECTION
           ============================================ */
        .real-photo-item { border-radius: var(--radius-small); overflow: hidden; cursor: pointer; }
        .real-photo-caption { font-size: var(--text-small); color: var(--text-2); font-style: italic; margin-top: var(--space-2); text-align: center; }

        /* Lightbox */

        /* ============================================
           BREADCRUMB BACK
           ============================================ */
        .breadcrumb-back {
            display: inline-flex; align-items: center; gap: var(--space-2);
            font-size: var(--text-small); font-weight: var(--primary-medium); text-transform: uppercase;
            letter-spacing: var(--letter-spacing-normal); color: var(--text-2); transition: all var(--hover-duration) var(--hover-ease);
            padding: var(--space-5) 0 0;
        }
        .breadcrumb-back:hover { color: var(--brand-500); }
        .breadcrumb-back svg {
            width: 1rem; height: 1rem; stroke: currentColor; stroke-width: 2;
            fill: none; transition: all var(--hover-duration) var(--hover-ease);
        }

        /* ============================================
           BACK LINK
           ============================================ */

        /* ============================================
           RESPONSIVE
           ============================================ */

}
</style>
