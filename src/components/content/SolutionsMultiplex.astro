---
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Img from '../media/Img.astro';
import Button from '../Button.astro';
---
<!-- ============================================
         HEADER
         ============================================ -->



    <!-- ============================================
         PAGE HERO
         ============================================ -->
    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/ino0.webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity);object-position:center var(--hero-position-solutions-multiplex)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Multi-sites</Eyebrow>
                <Heading tag="h1" variant="h1">Multiplex</Heading>
                <Paragraph variant="large">Connectez vos sites en temps r&eacute;el</Paragraph>
            </ContentWrapper>

    </Section>

    <!-- Breadcrumb retour -->
    <div class="site-container">
        <a href="/solutions" class="breadcrumb-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour nos solutions
        </a>
    </div>

    <!-- ============================================
         DETAIL
         ============================================ -->
    <Section theme="light">

            <Grid xsmall={1} small={1} medium={1} large={2} gap="8" tracks="var(--tracks-content-sidebar)">
                <div class="real-detail-text">
                    <Eyebrow tag="span" variant="tag">Multi-sites</Eyebrow>
                    <Heading tag="h2" variant="h2" class="alignment-start">Multiplex</Heading>
                    <hr class="divider">
                    <br>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Notre solution multiplex permet de connecter plusieurs sites en temps r&eacute;el pour des interventions simultan&eacute;es, fluides et naturelles. Gr&acirc;ce &agrave; des technologies de pointe comme la fibre optique et la 5G, nous assurons une transmission stable et de haute qualit&eacute; entre tous vos lieux d'&eacute;v&eacute;nement.
                    </Paragraph>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        Cette solution est id&eacute;ale pour les conf&eacute;rences multi-sites, les &eacute;v&eacute;nements hybrides ou les &eacute;missions n&eacute;cessitant des duplex entre diff&eacute;rents lieux. Chaque site b&eacute;n&eacute;ficie d'un dispositif complet de captation et de diffusion, synchronis&eacute; en temps r&eacute;el.
                    </Paragraph>
                    <ul class="feature-list">
                        <li>Connexion multi-sites en temps r&eacute;el</li>
                        <li>Technologies fibre optique et 5G</li>
                        <li>Transmission stable haute qualit&eacute;</li>
                        <li>Synchronisation parfaite entre les sites</li>
                    </ul>
                </div>
                <div class="real-sidebar">
                <div class="real-meta">
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                        <div>
                            <span class="meta-label">Type de solution</span>
                            <span class="meta-value">Connexion multi-sites</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                        <div>
                            <span class="meta-label">Technologie</span>
                            <span class="meta-value">Remote Production</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <div>
                            <span class="meta-label">Usage</span>
                            <span class="meta-value">Conf&eacute;rences multi-sites, duplex</span>
                        </div>
                    </div>
                </div>
                <!-- Video -->
                <div class="video-container">
                    <iframe src="https://player.vimeo.com/video/1006640017" title="inovae_1" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                </div>
                </div>
            </Grid>

            <!-- Photos -->
            <Grid xsmall={1} small={1} medium={2} large={3} gap="4">
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/ino0.webp"} alt={"Réalisation en Remote Production"} appearance="photo" />
                    <p class="photo-caption">R&eacute;alisation en Remote Production avec la r&eacute;ception des cam&eacute;ras de Bordeaux, Poitiers et Limoges</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/ino1.webp"} alt={"Les 3 villes en scène"} appearance="photo" />
                    <p class="photo-caption">Une des sc&egrave;nes avec les 3 villes de cette r&eacute;alisation</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/ino3.webp"} alt={"La régie de Bordeaux"} appearance="photo" />
                    <p class="photo-caption">La r&eacute;gie de Bordeaux avec sur le vid&eacute;oprojecteur en miniature le plan large de Limoges et le plan large de Poitiers pour le public de Bordeaux</p>
                </div>
            </Grid>

            <!-- Back link -->
            <Button element="link" variant="link" href={"/solutions"}>
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Retour aux solutions
            </Button>

    </Section>

    <ContactSection eyebrow={"Vous avez un projet similaire ?"} title={"Et si on travaillait ensemble ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />

    <!-- Lightbox -->


    <!-- Footer -->



<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            width: var(--size-3-125rem); height: var(--size-0-1875rem); background: var(--brand-500);
            margin: var(--space-4) var(--size-zero) var(--size-zero) var(--size-zero); border: none;
        }

        /* ============================================
           SOLUTION DETAIL
           ============================================ */
        .real-meta {
            display: flex; flex-direction: column; gap: var(--space-4);
            padding: var(--size-2-1875rem);
            background: var(--light-200);
            border-radius: var(--radius-small);
            border: var(--size-0-0625rem) solid var(--light-300);
        }
        .real-meta-item {
            display: flex; align-items: center; gap: var(--size-0-875rem);
        }
        .real-meta-item svg {
            width: var(--size-1-375rem); height: var(--size-1-375rem); flex-shrink: var(--size-zero);
            stroke: var(--brand-500); stroke-width: var(--number-two);
            fill: none; stroke-linecap: round; stroke-linejoin: round;
        }
        .meta-label {
            display: block; font-size: var(--size-0-7rem); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--size-0-0625rem);
            color: var(--text-2); margin-bottom: var(--size-0-125rem);
        }
        .meta-value {
            display: block; font-size: var(--size-0-95rem); font-weight: var(--primary-medium);
            color: var(--dark-900);
        }

        /* ============================================
           FEATURE LIST
           ============================================ */
        .feature-list { list-style: none; margin-top: var(--space-4); }
        .feature-list li {
            position: relative; padding-left: var(--size-1-375rem);
            font-size: var(--size-0-9rem); color: var(--text-2); line-height: var(--number-2-2);
        }
        .feature-list li::before {
            content: var(--content-timeline-before); position: absolute; left: var(--size-zero); top: var(--size-0-75rem);
            width: var(--size-0-625rem); height: var(--size-0-625rem); border-radius: var(--percentage-50);
            background: var(--brand-500);
        }

        /* ============================================
           BREADCRUMB BACK
           ============================================ */
        .breadcrumb-back {
            display: inline-flex; align-items: center; gap: var(--space-2);
            font-size: var(--size-0-78rem); font-weight: var(--primary-medium); text-transform: uppercase;
            letter-spacing: var(--size-0-0625rem); color: var(--text-2); transition: var(--motion-transition);
            padding: var(--space-5) var(--size-zero) var(--size-zero);
        }
        .breadcrumb-back:hover { color: var(--brand-500); }
        .breadcrumb-back svg {
            width: var(--size-1rem); height: var(--size-1rem); stroke: currentColor; stroke-width: var(--number-two);
            fill: none; transition: var(--motion-transition);
        }

        /* ============================================
           PHOTOS
           ============================================ */
        .real-photo-item { border-radius: var(--radius-small); overflow: hidden; cursor: pointer; }
        .real-photo-item .photo-caption { font-size: var(--size-0-82rem); color: var(--text-2); margin-top: var(--space-2); text-align: center; font-style: italic; }

        /* ============================================
           VIDEO
           ============================================ */
        .video-container { margin-top: var(--space-4); position: relative; padding-bottom: var(--percentage-56-25); height: var(--size-zero); overflow: hidden; border-radius: var(--radius-small); }
        .video-container iframe { position: absolute; top: var(--size-zero); left: var(--size-zero); width: var(--size-full); height: var(--size-full); border: var(--size-zero); border-radius: var(--radius-small); }

        /* ============================================
           LIGHTBOX
           ============================================ */

        /* ============================================
           BACK LINK
           ============================================ */

        /* ============================================
           RESPONSIVE
           ============================================ */

}
</style>
