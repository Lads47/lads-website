---
import LocalVideo from '../site/LocalVideo.astro';
import ContactSection from './ContactSection.astro';
import Section from '../wrapper/Section.astro';
import ContentWrapper from '../wrapper/ContentWrapper.astro';
import Eyebrow from '../typography/Eyebrow.astro';
import Heading from '../typography/Heading.astro';
import Paragraph from '../typography/Paragraph.astro';
import Grid from '../wrapper/Grid.astro';
import Img from '../media/Img.astro';
import Button from '../Button.astro';
---

    <Section theme="dark" paddingTop="navoverlap" paddingBottom="small" align="center">
<Img slot="background" src="/photo/peer-gynt.webp" alt="" loading="eager" style={"opacity:var(--hero-image-opacity)"} />

            <ContentWrapper centered class="width-site max-width-small margin-inline-auto">
                <Eyebrow tag="span">Spectacle vivant</Eyebrow>
                <Heading tag="h1" variant="h1">Peer Gynt &mdash; Op&eacute;ra de Limoges</Heading>
                <Paragraph variant="large">2024</Paragraph>
            </ContentWrapper>

    </Section>


    <div class="site-container">
        <a href="/realisations" class="breadcrumb-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour nos r&eacute;alisations
        </a>
    </div>


    <Section theme="light">

            <Grid xsmall={1} small={1} medium={1} large={2} gap="8" tracks="var(--tracks-content-sidebar)">
                <div class="real-detail-text">
                    <Eyebrow tag="span" variant="tag">Spectacle vivant</Eyebrow>
                    <Heading tag="h2" variant="h2" class="alignment-start">Peer Gynt</Heading>
                    <hr class="divider">
                    <br>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        La compagnie Clarac-Deloeil a r&eacute;interpr&eacute;t&eacute; l'op&eacute;ra Peer Gynt de Werner Egk en int&eacute;grant six cam&eacute;ras manipulables sur sc&egrave;ne et environ trente vid&eacute;os diffus&eacute;es sur le mur du d&eacute;cor d'une maison. Cette installation vid&eacute;o devenait partie int&eacute;grante de la narration du spectacle. L'objectif principal consistait &agrave; assurer la synchronisation pr&eacute;cise du lancement des vid&eacute;os et des plans de cam&eacute;ras affich&eacute;s sur le mur de diffusion.
                    </Paragraph>
                    <Paragraph variant="main" class="color-muted" maxWidth={70}>
                        L'&eacute;quipe a d&eacute;ploy&eacute; une r&eacute;gie compos&eacute;e de trois m&eacute;langeurs vid&eacute;o pour garantir la redondance et permettre aux op&eacute;rateurs une meilleure pr&eacute;cision d'ex&eacute;cution. Un syst&egrave;me de liaison par fibre optique a &eacute;t&eacute; utilis&eacute; pour connecter la r&eacute;gie aux cam&eacute;ras positionn&eacute;es sur sc&egrave;ne.
                    </Paragraph>
                </div>
                <div class="real-sidebar">
                <div class="real-meta">
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        <div>
                            <span class="meta-label">Client</span>
                            <span class="meta-value">Compagnie Clarac-Deloeil</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <div>
                            <span class="meta-label">Ann&eacute;e</span>
                            <span class="meta-value">2022 et 2024</span>
                        </div>
                    </div>
                    <div class="real-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <div>
                            <span class="meta-label">Lieu</span>
                            <span class="meta-value">Op&eacute;ra de Compi&egrave;gne &middot; Op&eacute;ra de Limoges</span>
                        </div>
                    </div>
                </div>

                <div class="video-container">
                    <LocalVideo name="peer-gynt" />
                </div>
                </div>
            </Grid>


            <Grid xsmall={1} small={1} medium={2} large={4} gap="4">
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/peer-gynt.webp"} alt={"La scène de l'Opéra de Limoges vue depuis la régie"} appearance="photo" />
                    <p class="real-photo-caption">La sc&egrave;ne de l'Op&eacute;ra de Limoges vue depuis notre r&eacute;gie</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20221126_225140.webp"} alt={"Le chef et les comédiens de Peer Gynt"} appearance="photo" />
                    <p class="real-photo-caption">Le chef et les com&eacute;diens de Peer Gynt</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20221124_091720.webp"} alt={"Chargement des régies par le treuil extérieur de l'Opéra de Compiègne"} appearance="photo" />
                    <p class="real-photo-caption">Chargement de nos r&eacute;gies par le treuil ext&eacute;rieur de l'Op&eacute;ra de Compi&egrave;gne</p>
                </div>
                <div class="real-photo-item">
                    <Img loading={"lazy"} src={"/photo/20221126_163455.webp"} alt={"La scène vue du public de l'Opéra de Compiègne"} appearance="photo" />
                    <p class="real-photo-caption">La sc&egrave;ne vue du public &agrave; l'Op&eacute;ra de Compi&egrave;gne</p>
                </div>
            </Grid>


            <Button element="link" variant="link" href={"/realisations"}>
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Retour aux r&eacute;alisations
            </Button>

    </Section>

    <ContactSection eyebrow={"Vous avez un projet similaire ?"} title={"On ajoute votre événement ?"} description={"Un projet en construction, un événement qui approche que vous envisagez de filmer et diffuser ? Parlons-en."} email={"prod@lesateliersdustream.fr"} phoneHref={"tel:+33661968858"} phone={"06 61 96 88 58"} locationAlt={"Nos bureaux"} training={false} />








<style is:global>
@layer components {

/* ============================================
           POLICES
           ============================================ */

        /* ============================================
           VARIABLES
           ============================================ */

        /* ============================================
           RESET
           ============================================ */

        /* ============================================
           PAGE HERO
           ============================================ */

        /* ============================================
           SECTIONS COMMUNES
           ============================================ */
        .divider {
            margin: var(--space-4) 0 0 0;
        }

        /* ============================================
           REALISATION DETAIL
           ============================================ */
        .real-meta {
            display: flex; flex-direction: column; gap: var(--space-4);
            padding: var(--space-5);
            background: var(--light-200);
            border-radius: var(--radius-small);
            border: var(--border-width) solid var(--light-300);
        }
        .real-meta-item {
            display: flex; align-items: center; gap: var(--space-3);
        }
        .real-meta-item svg {
            width: 1.375rem; height: 1.375rem; flex-shrink: 0;
            stroke: var(--brand-500); stroke-width: 2;
            fill: none; stroke-linecap: round; stroke-linejoin: round;
        }
        .meta-label {
            display: block; font-size: var(--text-small); font-weight: var(--primary-bold);
            text-transform: uppercase; letter-spacing: var(--letter-spacing-normal);
            color: var(--text-2); margin-bottom: var(--space-1);
        }
        .meta-value {
            display: block; font-size: var(--text-main); font-weight: var(--primary-medium);
            color: var(--dark-900);
        }

        /* ============================================
           PHOTO SECTION
           ============================================ */
        .real-photo-item {
            border-radius: var(--radius-small);
            overflow: hidden;
            cursor: pointer;
        }
        .real-photo-caption {
            font-size: var(--text-small);
            color: var(--text-2);
            font-style: italic;
            margin-top: var(--space-2);
            text-align: center;
        }

        /* Video */
        .video-container { margin-top: var(--space-4); position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-small); }
        .video-container video { display: block; width: 100%; border-radius: var(--radius-small); }

        /* Lightbox */

        /* ============================================
           BREADCRUMB BACK
           ============================================ */
        .breadcrumb-back {
            display: inline-flex; align-items: center; gap: var(--space-2);
            font-size: var(--text-small); font-weight: var(--primary-medium); text-transform: uppercase;
            letter-spacing: var(--letter-spacing-normal); color: var(--text-2); transition: all var(--hover-duration) var(--hover-ease);
            padding: var(--space-5) 0 0;
        }
        .breadcrumb-back:hover { color: var(--heading-accent); }
        .breadcrumb-back svg {
            width: 1rem; height: 1rem; stroke: currentColor; stroke-width: 2;
            fill: none; transition: all var(--hover-duration) var(--hover-ease);
        }

        /* ============================================
           BACK LINK
           ============================================ */

        /* ============================================
           RESPONSIVE
           ============================================ */

}
</style>
