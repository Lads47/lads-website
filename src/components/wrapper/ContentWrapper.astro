---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ContentWrapperVariant =
  | "stack"
  | "auto-width"
  | "columns"
  | "breakout"
  | "contain"
  | "sticky-content"
  | "sticky-visual"
  | "card";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Content layout. */
  variant?: ContentWrapperVariant;
};

type ColumnClasses = {
  /** First-column classes. */
  column1Class?: string;
  /** Second-column classes. */
  column2Class?: string;
};

type Props = Base &
  (
    | {
        variant?: "stack";
        reverse?: never;
        /** Center each column's content. */
        centered?: boolean;
        mediaOpacity?: never;
      }
    | {
        variant: "auto-width";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "columns" | "breakout" | "contain";
        /** Show the second column first. */
        reverse?: boolean;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "sticky-content" | "sticky-visual";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "card";
        reverse?: never;
        centered?: never;
        /**
         * Card visual opacity. Defaults to `70`.
         *
         * @min 0
         * @max 100
         * @int
         */
        mediaOpacity?: number;
      }
  ) &
  ColumnClasses;

type AllProps = Base &
  ColumnClasses & {
    variant?: ContentWrapperVariant;
    reverse?: boolean;
    centered?: boolean;
    mediaOpacity?: number;
  };

const {
  render = true,
  variant = "stack",
  reverse = false,
  centered = false,
  mediaOpacity,
  column1Class,
  column2Class,
  class: className,
  ...rest
} = Astro.props as AllProps;

const validMediaOpacity =
  mediaOpacity !== undefined &&
  Number.isFinite(mediaOpacity) &&
  mediaOpacity >= 0 &&
  mediaOpacity <= 100;

if (import.meta.env.DEV && mediaOpacity !== undefined) {
  if (!validMediaOpacity) {
    console.warn(
      `[lumos] <ContentWrapper mediaOpacity={${mediaOpacity}}> must be between 0 and 100; the default is used instead.`,
    );
  } else if (variant !== "card") {
    console.warn(
      `[lumos] <ContentWrapper variant="${variant}"> ignores mediaOpacity; only the card variant has a visual to fade.`,
    );
  }
}

const media =
  variant === "card" && validMediaOpacity && mediaOpacity !== 70
    ? `--_media-opacity: ${mediaOpacity}`
    : undefined;

const variantClasses =
  variant === "stack"
    ? []
    : variant === "card"
      ? ["card-layout", "theme-dark"]
      : [variant];

const column1 = await slotContent(Astro.slots);
const column2 = await slotContent(Astro.slots, "column2");
---

{render && (column1 || column2) && (
  <div
    class:list={[
      "layout",
      variantClasses,
      reverse && "reversed",
      centered && "centered",
      className,
    ]}
    style={media}
    {...rest}
  >
    {column1 && (
      <div class:list={[column1Class]}>
        <Fragment set:html={column1} />
      </div>
    )}
    {column2 && (
      <div class:list={[column2Class]}>
        <Fragment set:html={column2} />
      </div>
    )}
  </div>
)}

<style is:global>
  @layer components {
    .layout {
      /* layout defaults */
      --_visual-ratio: var(--number-3) / var(--number-two);
      --_alignment: start;
      --_column-count: var(--number-one);
      width: var(--size-full);
      display: flex;
      flex-direction: column;
      column-gap: var(--site-gutter);
      row-gap: var(--space-8);
      align-items: stretch;
      grid-template-columns: repeat(var(--_column-count), minmax(var(--size-zero), var(--size-1fr)));

      /* column defaults */
      & > * {
        display: flex;
        flex-direction: column;
        align-items: var(--_alignment, start);
        text-align: var(--_alignment, start);
        width: var(--size-full);
        max-width: var(--size-full);
      }
      & > :first-child {
        align-self: center;
      }

      /* visual ratio lock */
      & > :last-child:not(:has(> :not(.image, .video, .overlay))) {
        position: relative;
        border-radius: var(--radius-small);
        aspect-ratio: var(--_visual-ratio);
        & > :is(.image, .video, .overlay) {
          border-radius: inherit;
          position: absolute;
          inset: var(--size-zero);
          width: var(--size-full);
          height: var(--size-full);
        }
      }

      /* variant overrides */
      &.centered {
        --_alignment: center;
      }
      &.auto-width {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: var(--justify-content-nav-inner);
        align-items: end;
        row-gap: var(--space-6);
        & > * {
          width: auto;
          align-self: unset;
        }
        & > :last-child {
          min-width: min(var(--size-4rem), var(--size-full));
        }
      }
      &.columns {
        display: grid;
        column-gap: var(--section-space-small);
        @media (--mq-large-min) {
          --_column-count: var(--number-two);
          &.reversed {
            & > :last-child {
              order: var(--number-minus-one);
            }
          }
        }
      }
      &.sticky-content {
        --_visual-ratio: var(--number-one) / var(--number-one);
        display: grid;
        @media (--mq-large-min) {
          --_column-count: var(--number-two);
          & > :first-child {
            align-self: start;
            position: sticky;
            top: calc(var(--site-margin) + var(--nav-height));
          }
        }
      }
      &.sticky-visual {
        --_visual-ratio: var(--number-one) / var(--number-one);
        display: grid;
        @media (--mq-large-min) {
          --_column-count: var(--number-two);
          & > :first-child {
            align-self: start;
          }
          & > :last-child {
            align-self: start;
            position: sticky;
            top: calc(var(--site-margin) + var(--nav-height));
            max-height: calc(
              var(--size-100svh) - var(--nav-height) - var(--site-margin) * var(--number-two)
            );
          }
        }
      }
      &.breakout {
        display: grid;
        width: var(--size-100cqi);
        flex-shrink: var(--size-zero);
        align-self: center;
        column-gap: var(--size-zero);
        row-gap: var(--size-zero);
        & > :first-child {
          margin-inline: auto;
          width: var(--site-width);
          padding-block: var(--section-space-medium);
        }
        & > :last-child {
          border-radius: var(--size-zero);
        }
        @media (--mq-large-min) {
          --_column-count: var(--number-two);
          & > :first-child {
            max-width: calc(var(--max-width-main) / var(--number-two));
          }
          & > :last-child {
            border-top-left-radius: var(--radius-small);
            border-bottom-left-radius: var(--radius-small);
          }
          &.reversed {
            & > :last-child {
              order: var(--number-minus-one);
              border-top-left-radius: var(--size-zero);
              border-bottom-left-radius: var(--size-zero);
              border-top-right-radius: var(--radius-small);
              border-bottom-right-radius: var(--radius-small);
            }
          }
        }
      }
      &.contain {
        display: grid;
        column-gap: var(--size-zero);
        row-gap: var(--size-zero);
        background-color: var(--background-2);
        border-radius: var(--radius-main);
        position: relative;
        overflow: clip;
        & > :first-child {
          padding: var(--space-6);
        }
        & > :last-child {
          border-radius: var(--size-zero);
        }
        @media (--mq-large-min) {
          --_column-count: var(--number-two);
          &.reversed {
            & > :last-child {
              order: var(--number-minus-one);
            }
          }
        }
      }
      &.card-layout {
        border-radius: var(--radius-main);
        position: relative;
        overflow: clip;
        min-height: var(--size-26rem);
        justify-content: var(--justify-content-button-wrap);
        & > :first-child {
          padding: var(--space-6);
        }
        & > :first-child {
          padding-block: var(--section-space-medium);
          padding-inline: var(--space-5);
          position: relative;
          z-index: var(--number-one);
          --_alignment: center;
        }
        & > :last-child {
          position: absolute;
          inset: var(--size-zero);
          border-radius: var(--size-zero);
          width: var(--size-full);
          height: var(--size-full);
          opacity: calc(var(--_media-opacity, 70) / var(--opacity-100));
          pointer-events: none;
        }
      }
    }

    /* breakout container */
    .section:has(.layout.breakout) {
      container-type: inline-size;
    }
  }
</style>
